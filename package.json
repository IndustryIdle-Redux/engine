{
    "name": "@industry-idle/engine",
    "version": "0.1.0",
    "description": "2D rendering engine: WebGPU/WebGL2 batching, bitmap fonts, grid geometry, worldgen",
    "license": "GPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/IndustryIdle-Redux/engine.git"
    },
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*.ts"
    },
    "scripts": {
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "bench:grid": "vitest run --config vite.bench.config.ts"
    },
    "devDependencies": {
        "@webgpu/types": "^0.1.74",
        "typescript": "4.9.5",
        "vite": "^6.0.5",
        "vitest": "^2.1.8"
    },
    "engines": {
        "node": ">=20"
    }
}
